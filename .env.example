# Desarrollo (npm run dev): ver .env.development — proxy /api/v1 -> localhost:1001
# Producción (npm run build): ver .env.production
VITE_API_URL=/api/v1
# Tiempo máximo del listado y la exportación del directorio en vivo, en milisegundos.
# Debe coincidir con USER_STATUS_DIRECTORY_TIMEOUT_MS del backend.
VITE_USER_STATUS_DIRECTORY_TIMEOUT_MS=120000
